      "applies_to": ["x402-gate", "plugin-trustgate", "twzrd-preflight"],
      "evidence": {
        "preflight": { "status": 200, "body": { "readiness_card": { "decision": "allow", "trust_score": 80, "score": 0.8, "can_spend": true, "recommended_cap_usdc": 1 } } },
        "merchant_card": { "status": 200, "body": { "wash_flagged": false, "confidence": "full", "ring_evaluated": true, "wash_stale": true } }
      },
