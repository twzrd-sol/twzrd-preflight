    },
    {
      "id": "stale_receipt",
      "covers": "stale receipt",
      "description": "A stored paid receipt that allowed this seller is past the buyer's maximum age, and intel is unreachable for the re-check. A consumer that reuses the receipt pays; one that re-checks first refuses on the outage.",
      "applies_to": ["receipt-consumer"],
      "not_applicable": {
        "x402-gate": "The gate takes no stored receipt: it reads the preflight and merchant card fresh for every payment. On this vector's fresh evidence (a preflight outage) it records outage_preflight's outcome.",
        "plugin-trustgate": "checkTrust takes no stored receipt; it calls the preflight on every check.",
        "twzrd-preflight": "The hook takes no stored receipt. It does reuse its own preflight decision for cacheTtlMs (1 hour by default), which no vector covers."
      },
      "evidence": {
        "receipt": { "decision": "allow", "issued_seconds_ago": 691200, "recheck_after_seconds_ago": 86400 },
        "preflight": { "status": 503, "body": { "detail": "unavailable" } },
        "merchant_card": { "status": 503, "body": { "detail": "unavailable" } }
      },
      "policy": { "max_receipt_age_seconds": 604800 },
      "expect": { "pays": false, "decision": "unavailable", "reason_code": "INTEL_UNAVAILABLE" }
    },
