{
  "schema": "twzrd.guard_vectors.v1",
  "decision_contract": "twzrd.payment_decision.v1",
  "$comment": "Shared guard vectors. Each vector is the evidence intel serves, the buyer's policy, and the outcome every pre-sign guard must reach: whether it lets the payment be signed (pays) and the payment_decision.v1 decision and reason_code it records. Evidence is served by a stub at each guard's HTTP boundary; no vector needs live intel. A guard runs a vector when its id is in applies_to, and states why otherwise in not_applicable. The policy of a vector is policy_baseline with the vector's policy merged over it, and a runner passes every key explicitly, so no expected outcome depends on a guard's defaults. A refusal must make zero signer calls and zero RPC calls. Canonical copy: docs/vectors in twzrd-trust; twzrd-x402-gate/test/fixtures holds a byte-identical copy.",
  "challenge": {
    "scheme": "exact",
    "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
    "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    "amount": "1000",
    "price_usdc": 0.001,
    "pay_to": "CktRuQ2mttgRGkXJtyksdKHjUdc2C4TgDzyB98oEzy8"
  },
  "policy_baseline": {
    "fail_open": false,
    "min_trust_score": 40,
    "gate_on_can_spend": false,
    "refuse_unevaluated": true,
    "refuse_uncapped_warn": true,
    "refuse_wash_flagged": true,
    "refuse_wash_unknown": true,
    "wash_max_usdc": null
  },
  "guards": {
    "x402-gate": "twzrd-x402-gate: the before-payment hook behind createGuardedX402Fetch, run with a counting signer; its approval is projected by decisionFromApproval.",
    "plugin-trustgate": "@wzrd_sol/plugin-trustgate: canSpendSafely / checkTrust, the readiness-card guard behind the eliza provider and the Faremeter payerChooser.",
    "twzrd-preflight": "twzrd-preflight: the OpenClaw before_tool_call hook, run on an exec curl that names the seller wallet and price. It reads the preflight decision and the merchant card's wash_flagged.",
    "receipt-consumer": "A consumer that stores a paid receipt and decides whether to reuse it (evaluateRecall in @wzrd_sol/sdk)."
  },
  "vectors": [
    {
      "id": "allow",
      "covers": "allow",
      "description": "An evaluated seller intel allows, with full wash coverage and no wash finding.",
      "applies_to": ["x402-gate", "plugin-trustgate", "twzrd-preflight"],
      "evidence": {
        "preflight": { "status": 200, "body": { "readiness_card": { "decision": "allow", "trust_score": 80, "score": 0.8, "can_spend": true, "recommended_cap_usdc": 1 } } },
        "merchant_card": { "status": 200, "body": { "wash_flagged": false, "confidence": "full", "ring_evaluated": true } }
      },
      "policy": {},
      "expect": { "pays": true, "decision": "allow", "reason_code": "ALLOW" }
    },
    {
      "id": "warn_under_cap",
      "covers": "warn under cap",
      "description": "Intel says warn with a $0.01 cap; the $0.001 price is under it.",
      "applies_to": ["x402-gate", "plugin-trustgate", "twzrd-preflight"],
      "evidence": {
        "preflight": { "status": 200, "body": { "readiness_card": { "decision": "warn", "trust_score": 60, "score": 0.6, "can_spend": true, "recommended_cap_usdc": 0.01 } } },
        "merchant_card": { "status": 200, "body": { "wash_flagged": false, "confidence": "full", "ring_evaluated": true } }
      },
      "policy": {},
      "expect": { "pays": true, "decision": "warn", "reason_code": "INTEL_WARN" }
    },
    {
      "id": "warn_over_cap",
      "covers": "warn over cap",
      "description": "Intel says warn with a $0.0005 cap; the $0.001 price is over it.",
      "applies_to": ["x402-gate", "plugin-trustgate", "twzrd-preflight"],
      "evidence": {
        "preflight": { "status": 200, "body": { "readiness_card": { "decision": "warn", "trust_score": 60, "score": 0.6, "can_spend": true, "recommended_cap_usdc": 0.0005 } } },
        "merchant_card": { "status": 200, "body": { "wash_flagged": false, "confidence": "full", "ring_evaluated": true } }
      },
      "policy": {},
