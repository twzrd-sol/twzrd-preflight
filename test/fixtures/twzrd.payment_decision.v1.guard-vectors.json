      "applies_to": ["x402-gate", "plugin-trustgate", "twzrd-preflight"],
      "evidence": {
        "preflight": { "status": 200, "body": { "readiness_card": { "decision": "warn", "trust_score": 45, "score": null, "null_reason": "unknown_subject", "can_spend": true, "recommended_cap_usdc": 0.1 } } },
        "merchant_card": { "status": 200, "body": { "wash_flagged": false, "confidence": "full", "ring_evaluated": true } }
