{
  "name": "twzrd-preflight",
  "version": "0.2.0",
  "description": "TWZRD OpenClaw plugin 0.2.0: wrapFetchWithTwzrdPreflight intercepts HTTP 402 (wash refuse, fail-closed, enforce). Also gates payment-shaped tool calls. Shadow/fail-open/wash-off are opt-in.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "twzrd-preflight": "cli.js"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "files": [
    "index.js",
    "wrap-fetch.js",
    "cli.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "twzrd-x402-gate": "^0.8.19"
  },
  "scripts": {
    "test": "node test/harness.mjs"
  },
  "keywords": [
    "openclaw",
    "x402",
    "trust",
    "preflight",
    "agent-payments",
    "solana",
    "agentcash"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-preflight.git"
  },
  "homepage": "https://intel.twzrd.xyz",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "openclaw": "^2026.7.1-2"
  }
}
