{
  "name": "twzrd-preflight",
  "version": "0.5.0",
  "description": "TWZRD OpenClaw plugin 0.5.0: wrapFetchWithTwzrdPreflight intercepts HTTP 402 (fail-closed, enforce) on twzrd-x402-gate@0.13.0, and payment-shaped tool calls get the same refusals: wash flagged or unknown, an uncapped warn, an unevaluated seller. Shadow, fail-open and each opt-out are opt-in.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "twzrd-preflight": "cli.js"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "files": [
    "index.js",
    "wrap-fetch.js",
    "cli.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "twzrd-x402-gate": "0.13.0"
  },
  "scripts": {
    "test": "node test/harness.mjs && node --test test/guard-vectors.test.mjs"
  },
  "keywords": [
    "openclaw",
    "x402",
    "trust",
    "preflight",
    "agent-payments",
    "solana",
    "agentcash"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twzrd-sol/twzrd-preflight.git"
  },
  "homepage": "https://intel.twzrd.xyz",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "openclaw": "^2026.10.5"
  }
}
